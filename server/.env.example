# Copy to server/.env. The Rust server loads it with dotenvy.
GHOST_ENV=development
HOST=0.0.0.0
PORT=8787
DB_PATH=./data/ghostai.sqlite

# Generate secrets with:
#   cargo run -p ghost-control-server --bin gen-secrets
# Keep CODE_PEPPER stable and backed up; changing it invalidates existing codes.
ADMIN_PASSWORD=REPLACE_WITH_A_LONG_UNIQUE_PASSWORD
CODE_PEPPER=REPLACE_WITH_64_HEXADECIMAL_CHARACTERS

# Server-only secret. Never place this in the desktop ZIP.
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Production: HTTPS origin behind one trusted reverse proxy that overwrites/appends X-Forwarded-For.
# PUBLIC_ORIGIN=https://ghostai.example.com
# TRUST_PROXY=true

MAX_OUTPUT_TOKENS=2048
IMAGE_TOKEN_RESERVE=4096
MAX_IMAGES=5
MAX_IMAGE_BYTES=2097152
SESSION_DAYS=30
PROVIDER_TIMEOUT_MS=90000
