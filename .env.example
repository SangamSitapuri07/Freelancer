# ── Server ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# SQLite location. In Docker, use /app/data.
DATA_DIR=./data
DB_PATH=./data/ghostgate.db

# ── Initial admin ──────────────────────────────────────────────────────
# Used only when the admins table is empty. Change these before deploying.
ADMIN_EMAIL=admin@ghostgate.local
ADMIN_PASSWORD=GhostGate!2026
ADMIN_NAME=Administrator

# ── Security ───────────────────────────────────────────────────────────
# A long random secret used to HMAC device IDs. If empty, a pepper is
# generated and stored in data/pepper.key. Set this explicitly in production.
HWID_PEPPER=

# License session lifetime (hours)
SESSION_HOURS=24
# Admin session lifetime (hours)
ADMIN_SESSION_HOURS=12

# Comma-separated browser origins allowed to call the API. Leave empty for
# same-origin dashboard access only. Use * only for local development.
CORS_ORIGIN=

# ── AI provider (server-side only) ─────────────────────────────────────
# The client never sees this key. Use any OpenAI-compatible chat completions API.
AI_BASE_URL=https://api.groq.com/openai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_MS=90000

# Credit formula: creditsPerRequest + ceil(totalTokens / tokensPerCredit)
AI_CREDITS_PER_REQUEST=1
AI_TOKENS_PER_CREDIT=1000

# Optional. The default system prompt is a safe coding-assistant prompt.
# AI_SYSTEM_PROMPT=You are a helpful software engineering assistant.
